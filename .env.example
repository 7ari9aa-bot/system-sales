# ============================================================
# Sales OS — environment template (NEVER commit real values)
# ============================================================

# --- runtime ---
ENVIRONMENT=local                # local | staging | production
DEBUG=true

# --- database (Supabase Postgres in production) ---
# Local:      postgresql+asyncpg://postgres:postgres@localhost:5432/sales
# Supabase:   session pooler :5432 with user postgres.<project-ref> for admin/migrations,
#             transaction pooler :6543 for API/workers (SET LOCAL tenant GUC per tx).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales
DATABASE_URL_ADMIN=
# App runtime role — created by scripts/provision.py (no bypassrls: RLS applies).
DATABASE_URL_APP=
DATABASE_URL_APP_ADMIN=

# --- redis (Railway in production; separate instances for cache vs streams) ---
REDIS_URL=redis://localhost:6379/0

# --- auth ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- event bus ---
STREAM_MAXLEN=100000
CONSUMER_BLOCK_MS=5000

# --- object storage (S3-compatible) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers (Stage 6) ---
AI_PROVIDER_PRIMARY=
AI_API_KEY_PRIMARY=
AI_PROVIDER_FALLBACK=
AI_API_KEY_FALLBACK=
EMBEDDINGS_API_KEY=

# --- channels (Stage 5) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

# --- notifications (Stage 9) ---
SMTP_URL=
SMS_PROVIDER_KEY=
PUSH_SERVICE_KEY=

# --- billing (Stage 10) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- internal service auth (n8n -> core callbacks) ---
SERVICE_TOKEN_INTERNAL=

# --- §68 secrets at rest (integration credentials envelope encryption) ---
# Base64-encoded master key; MUST decode to >= 32 bytes in staging/production
# (generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())").
# Empty is allowed ONLY in local/test (a published dev-only key is used).
SECRETS_MASTER_KEY=
# §69 rotation grace: comma-separated PREVIOUS master keys, kept for
# decryption only while rows encrypted under them are lazily re-encrypted.
SECRETS_PREVIOUS_MASTER_KEYS=
