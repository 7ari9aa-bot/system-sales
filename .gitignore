# --- secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
dist/
build/

# --- node / next ---
node_modules/
.next/
# `mv .next .next.stale` is the documented workaround for the sandbox blocking
# Next's own cache cleanup; without this the 137MB directory shows up as
# untracked and is one `git add -A` away from being committed.
.next.stale/
out/
*.tsbuildinfo
next-env.d.ts

# --- playwright (test artefacts, never source) ---
test-results/
test-results.*/
playwright-report/
blob-report/
.playwright/
# Variants created by the `mv` workarounds for the sandbox blocking Next's and
# Playwright's own cache cleanup. `.next/` alone does not cover `.next.dev/`,
# `.next.prev/` etc., and each one left untracked junk that was one `git add -A`
# away from being committed.
.next.*/

# --- misc ---
.DS_Store
*.log
.idea/
.vscode/
.vercel
.env*

# --- assistant workspace (local agent memory / notes, not project source) ---
.workbuddy-ai/

# --- parallel agent workspace (an INDEPENDENT git repo) ---
# Without this, `git add -A` in the main repo stages the nested repo as a
# gitlink (mode 160000) instead of ignoring it — a confusing half-commit that
# records a SHA pointing at nothing. The feature is merged later by copying it
# into backend/app/modules/website/, not by committing the folder.
website-builder/

# --- scratch workspace for the builder tooling (temp diffs, no project data) ---
.builder/
.zcode/
.zcodeignore
.wave-f-hold/
vibe_images/

# --- agent / tool workspace (auto-generated, never source) ---
.codebuddy/
.red-a2/
.kilo/
