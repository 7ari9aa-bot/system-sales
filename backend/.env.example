# ============================================================
# Backend — environment template (NEVER commit real values).
# Every value below is a PLACEHOLDER; see app/core/config.py for
# the authoritative list of settings and their validation rules.
# ============================================================

# --- runtime ---
# ENVIRONMENT defaults to "production" (the secure direction): local
# development must set it explicitly, anything unrecognised fails closed.
ENVIRONMENT=local                # local | staging | production
# DEBUG defaults to false; only the log level — never needed in production.
DEBUG=false
# Comma-separated explicit origins. "*" is refused outside local/test.
CORS_ORIGINS=http://localhost:3000
# Canonical HTTPS origin provider callbacks are registered under. Never
# inferred from the inbound Host header.
API_PUBLIC_BASE_URL=
FRONTEND_PUBLIC_URL=http://localhost:3000
# How many reverse proxies sit between the internet and this process and are
# trusted to APPEND their peer to X-Forwarded-For. The real client is the
# entry N hops from the RIGHT of the chain (everything further left is
# attacker-injectable). 1 = a single fronting proxy; set 2 behind a chain
# (e.g. Cloudflare -> Vercel -> app) or every user collapses to one IP.
TRUSTED_PROXY_COUNT=1

# --- database (Supabase Postgres in production) ---
# Local:      postgresql+asyncpg://postgres:postgres@localhost:5432/sales
# Supabase:   session pooler :5432 for admin/migrations, transaction pooler
#             :6543 for API/workers (SET LOCAL tenant GUC per transaction).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sales
# Transaction-mode pooler (Supavisor :6543) — the app runtime path.
DATABASE_URL_POOLER=postgresql+asyncpg://postgres:postgres@localhost:6543/sales
DATABASE_URL_ADMIN=
# App runtime role — created by scripts/provision.py (no bypassrls: RLS applies).
DATABASE_URL_APP=
DATABASE_URL_APP_ADMIN=
SALES_APP_DB_PASSWORD=
# Pool sizing: the worker holds TWO connections per in-flight event; the
# per-tenant concurrency gate derives its default from pool + overflow.
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=10
# §144 per-tenant in-flight cap. 0 = derive from the DB pool (recommended);
# set a positive number to pin it explicitly.
TENANT_CONCURRENCY=0

# --- redis (separate instances for cache vs streams in production) ---
REDIS_URL=redis://localhost:6379/0

# --- auth ---
JWT_SECRET=
# Zero-logout rotation: the PREVIOUS signing secret. Tokens carry a kid
# header, so during a roll old tokens verify against this until they expire
# naturally. Leave empty when no rotation is in progress; when set it must be
# >= 32 bytes and differ from JWT_SECRET.
JWT_SECRET_PREVIOUS=
# Pinned to HS256 on BOTH token sides; any other value is refused outside
# local/test.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600
# HttpOnly cookie auth. Unset = AUTO: secure everywhere except
# ENVIRONMENT=local. Set explicitly in staging/production if the dashboard
# ever serves over plain http behind a trusted proxy.
AUTH_COOKIE_SECURE=
WEBCHAT_SESSION_TTL_SECONDS=2592000

# --- account recovery email (Resend; server-only credentials) ---
# Keep delivery disabled until the sender domain is verified. Secure
# environments require it unless EMAIL_DELIVERY_STRICT=false is set
# EXPLICITLY (soft-launch opt-out: password-reset-by-email is unavailable).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DELIVERY_ENABLED=false
EMAIL_DELIVERY_STRICT=true

# --- event bus / workers ---
STREAM_MAXLEN=100000
CONSUMER_BLOCK_MS=5000
WORKER_MAX_ATTEMPTS=5

# --- circuit breaker (§47, every external dependency) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_SUCCESSES=2

# --- AI providers (OpenAI-compatible primary; per-tenant overrides via
#     model_configs take precedence) ---
AI_PROVIDER_PRIMARY=
AI_API_KEY_PRIMARY=
AI_BASE_URL_PRIMARY=
# §42 monthly AI spend cap (USD) applied when a tenant has no BudgetPolicy.
AI_MONTHLY_BUDGET_CAP_DEFAULT=50
# §36 USD per minute of inbound audio transcription.
AI_STT_COST_PER_MINUTE=0.01

# --- Voice (§35-36): speech-to-text and text-to-speech are their own services ---
# Both fall back to AI_API_KEY_PRIMARY / AI_BASE_URL_PRIMARY when left empty, so
# a deployment that already configured the chat provider gets voice working with
# no second credential. Set them explicitly to point voice at another vendor.
# `whisper-1` and `tts-1` are NOT chat models — they are their own model names.
AI_STT_API_KEY=
AI_STT_BASE_URL=
AI_STT_MODEL=whisper-1
AI_TTS_API_KEY=
AI_TTS_BASE_URL=
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# --- Customer Agent vision stack (§12, single source of truth) ---
# The multimodal embedding speaks DashScope's native schema (NOT the
# OpenAI-compatible one) and the reranker speaks Jina's. tongyi-embedding-
# vision-flash emits fixed 768-dim vectors — changing the model means a full
# re-index (the pgvector column is pinned to that width).
AI_EMBEDDING_VISION_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
AI_EMBEDDING_VISION_API_KEY=
AI_EMBEDDING_VISION_MODEL=tongyi-embedding-vision-flash
AI_EMBEDDING_VISION_DIMENSIONS=768
AI_RERANKER_BASE_URL=https://api.jina.ai/v1
AI_RERANKER_API_KEY=
AI_RERANKER_MODEL=jina-reranker-m0

# --- channels ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Telegram: the webhook URL carries ?tenant_key=<public_key>; the secret must
# contain 16-256 letters, digits, '_' or '-'.
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Email channel webhook signature (empty = the email ingress refuses
# every request — fail-closed like the other channel secrets).
EMAIL_WEBHOOK_SECRET=

# --- Facebook Login for Business (Meta OAuth connect flow) ---
# Placeholders for the identity connect flow. META_OAUTH_REDIRECT_URI wins
# when set; otherwise the callback is derived from API_PUBLIC_BASE_URL
# (/api/v1/integrations/meta/oauth/callback). META_OAUTH_CONFIG_ID is ONLY
# for Business-type apps (replaces the scope list on the login dialog).
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_OAUTH_CONFIG_ID=

# --- object storage (S3-compatible; required together in secure envs) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# --- outbox relay ---
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=300
OUTBOX_FAILED_REQUEUE_SECONDS=300

# --- internal service auth (trusted operational consumers) ---
SERVICE_TOKEN_INTERNAL=

# --- Website Platform integration (external presentation plane) ---
WEBSITE_PLATFORM_TENANT_KEYS=
WEBSITE_PLATFORM_API_URL=
WEBSITE_PLATFORM_STUDIO_URL=
WEBSITE_PLATFORM_API_KEY=

# --- §68 secrets at rest (integration credentials envelope encryption) ---
# Base64-encoded master key; MUST decode to >= 32 bytes in staging/production
# (generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())").
# Empty is allowed ONLY in local/test (a published dev-only key is used).
SECRETS_MASTER_KEY=
# §69 rotation grace: comma-separated PREVIOUS master keys, kept for
# decryption only while rows encrypted under them are lazily re-encrypted.
SECRETS_PREVIOUS_MASTER_KEYS=
