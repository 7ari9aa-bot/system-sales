{
  "name": "Sales OS — WhatsApp Inbound",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "verify-get",
      "name": "Webhook Verify (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "whatsapp-verify"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {}
      },
      "id": "respond-challenge",
      "name": "Respond Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "onReceived",
        "options": { "rawBody": true }
      },
      "id": "inbound-post",
      "name": "WhatsApp Events (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 200],
      "webhookId": "whatsapp-events"
    },
    {
      "parameters": {
        "jsCode": "const secret = $env.WHATSAPP_APP_SECRET;\nconst raw = $input.item.json.rawBody ?? JSON.stringify($input.item.json.body);\nconst sig = $input.item.json.headers['x-hub-signature-256'] ?? '';\nconst crypto = require('crypto');\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\nif (sig !== expected) { throw new Error('invalid signature'); }\nreturn [{ json: { raw: $input.item.json.body } }];"
      },
      "id": "check-signature",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SALES_OS_CORE_URL }}/webhooks/whatsapp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.SALES_OS_SERVICE_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Hub-Signature-256", "value": "={{ $json.sig_header }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.raw) }}",
        "options": {}
      },
      "id": "forward-core",
      "name": "Forward to Sales OS Core",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 200]
    }
  ],
  "connections": {
    "Webhook Verify (GET)": { "main": [[{ "node": "Respond Challenge", "type": "main", "index": 0 }]] },
    "WhatsApp Events (POST)": { "main": [[{ "node": "Verify Signature", "type": "main", "index": 0 }]] },
    "Verify Signature": { "main": [[{ "node": "Forward to Sales OS Core", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
