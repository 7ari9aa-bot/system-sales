{
  "name": "Sales OS — WhatsApp Outbound",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-send",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "send-hook",
      "name": "Send Request (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "whatsapp-send"
    },
    {
      "parameters": {
        "jsCode": "const expected = $env.SALES_OS_SERVICE_TOKEN;\nconst auth = $input.item.json.headers['authorization'] ?? '';\nif (auth !== 'Bearer ' + expected) { throw new Error('unauthorized'); }\nconst body = $input.item.json.body;\nif (!body?.phone_number_id || !body?.to || !body?.payload) { throw new Error('missing fields'); }\nreturn [{ json: body }];"
      },
      "id": "auth-validate",
      "name": "Validate Auth + Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.phone_number_id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {}
      },
      "id": "graph-send",
      "name": "Graph API Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Send Request (POST)": { "main": [[{ "node": "Validate Auth + Body", "type": "main", "index": 0 }]] },
    "Validate Auth + Body": { "main": [[{ "node": "Graph API Send", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
