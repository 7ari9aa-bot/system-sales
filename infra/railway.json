# Railway deployment blueprint.
# Services:
#   api          -> infra/Dockerfile.backend (uvicorn)
#   workers      -> same image, command: python -m app.workers.run messages notifications webhooks
#   outbox-relay -> same image, command: python -m app.workers.run relay-only
#   frontend     -> frontend/ (Next.js, nixpacks or node)
#   n8n          -> public image n8nio/n8n (enable when needed)
#
# Required env vars (set in Railway dashboard, NEVER in git):
#   ENVIRONMENT=production, DEBUG=false
#   DATABASE_URL / DATABASE_URL_APP (Supabase pooler :6543)
#   DATABASE_URL_ADMIN (migrations job only)
#   REDIS_URL (Railway Redis — separate instances for cache vs streams)
#   JWT_SECRET, SERVICE_TOKEN_INTERNAL
#   WHATSAPP_*, TELEGRAM_*, AI_* keys per integrations
#   S3_* (media persistence)
#
# Deploy order: migrate job (alembic upgrade head) -> api -> workers -> frontend.

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "infra/Dockerfile.backend" },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT --workers 2",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
